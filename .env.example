# ─── Google OAuth (Calendar + Gmail) ─────────────────────────────────────────
# Create at: https://console.cloud.google.com/apis/credentials
# Type: Web application
# Redirect URI: http://localhost:3001/oauth/callback
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/oauth/callback

# After first auth run, these are written here automatically:
# (run: pnpm run auth gcal)
GOOGLE_ACCESS_TOKEN=
GOOGLE_REFRESH_TOKEN=
GOOGLE_TOKEN_EXPIRY=

# ─── Asana ────────────────────────────────────────────────────────────────────
# Create at: https://app.asana.com/0/my-apps → Personal Access Tokens
ASANA_PAT=your-asana-personal-access-token

# ─── LLM Backend (choose one) ─────────────────────────────────────────────────
# Option A: Amazon Bedrock (recommended)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
COS_LLM_MODEL=anthropic.claude-sonnet-4-6
COS_EMBED_MODEL=cohere.embed-v4:0

# Option B: OpenAI (simpler local dev)
# OPENAI_API_KEY=sk-...
# COS_LLM_MODEL=gpt-5-mini
# COS_EMBED_MODEL=text-embedding-3-large

# Option C: Mock (no API keys — fixture embeddings only, for demo/CI)
# COS_MOCK_LLM=true
# COS_MOCK_EMBED=true

# ─── Database ─────────────────────────────────────────────────────────────────
# Local file path for libSQL database
COS_DB_PATH=~/.cos/graph.db

# ─── LangSmith Observability ──────────────────────────────────────────────────
# Create at: https://smith.langchain.com
# Required before any prompt iteration (per build-ai-agents skill)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=cos-prototype
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Set to true once you have a LangSmith API key; false disables tracing (safe for CI/local without key)
LANGSMITH_TRACING=false

# ─── Application ──────────────────────────────────────────────────────────────
COS_OWNER_EMAIL=your-email@example.com
COS_DEMO_MODE=false
